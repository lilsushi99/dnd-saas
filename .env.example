# Nexus ERP Enterprise - Environment Configuration

# Application

NODE_ENV=development
PORT=3000
APP_NAME="Nexus ERP Enterprise"
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
TIMEZONE=Africa/Lagos

# Database - MySQL

DB_HOST=srv2027.hstgr.io
DB_PORT=3306
DB_NAME=u475835399_erpdb
DB_USER=u475835399_erpuser
DB_PASSWORD="ProductDesigner@2022"

# Authentication and Security

JWT_SECRET=nexus_erp_enterprise_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
SESSION_SECRET=nexus_erp_enterprise_session_secret_change_in_production
BCRYPT_ROUNDS=10

# File Uploads

UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,application/pdf

# Logging

LOG_LEVEL=info

# CORS

CORS_ORIGIN=*

# Google Gemini AI

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
