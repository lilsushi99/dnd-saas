# Nexus ERP Enterprise - Environment Configuration

# Application

NODE_ENV=development
PORT=3000
APP_NAME="Nexus ERP Enterprise"
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
TIMEZONE=Africa/Lagos

# Database - MySQL (put real values in .env or your host's environment; NEVER commit them here)

DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=

# Security & Authentication Secrets
# REQUIRED in production: a long random value (e.g. `openssl rand -hex 48`). The server refuses to start in
# production with this placeholder or with no value.
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=24h
SESSION_SECRET=
BCRYPT_ROUNDS=10

# File Uploads

UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,application/pdf

# Server Diagnostics & CORS Rules
LOG_LEVEL=info
# The SPA is served by this same server, so no CORS origin is needed. Leave empty unless you host the UI elsewhere.
CORS_ORIGIN=
TIMEZONE=UTC+01:00

# Optional External API Integrations (Google Gemini AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Administrative recovery (used only by `npm run admin:create`; pass on the command line, do not commit):
# ADMIN_EMAIL=you@company.com
# ADMIN_NAME="Your Name"
# ADMIN_PASSWORD=at-least-10-characters

# Development only: when true AND NODE_ENV is not production, an unreachable MySQL falls back to a NON-PERSISTENT
# in-memory database (e.g. AI Studio previews). Ignored in production. /api/health reports "degraded" while active.
ALLOW_MEMORY_DB=false
