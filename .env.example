# ==========================================
# NEXUS ERP ENTERPRISE - ENVIRONMENT CONFIG
# ==========================================

# Environment & Server Settings
NODE_ENV=development
PORT=3000
APP_NAME="Nexus ERP Enterprise"
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_erp
DB_USER=root
DB_PASSWORD=your_database_password_here

# Security & Authentication Secrets
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=24h
SESSION_SECRET=change_this_session_secret_in_production
BCRYPT_ROUNDS=10

# Media & File Upload Directory Settings
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,application/pdf

# Server Diagnostics & CORS Rules
LOG_LEVEL=info
CORS_ORIGIN=*
TIMEZONE=UTC+01:00

# Optional External API Integrations (Google Gemini AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
